<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.myruoyi.mapper.SysUserMapper">

    <!--     登录时验证账号-->
    <select id="selectByUsername" resultType="com.example.myruoyi.domain.SysUser">
        SELECT user_id, user_name, password, status, del_flag, create_time
        FROM sys_user
        WHERE user_name = #{userName}
          AND del_flag = '0'
    </select>

    <!--    查询所有可用用户-->
    <select id="selectUserList" resultType="com.example.myruoyi.domain.SysUser">
        SELECT user_id, user_name, password, status, del_flag, create_time
        FROM sys_user
        WHERE del_flag = '0'
        order by user_id
    </select>

    <!--    按id查询用户-->
    <select id="selectByUserId" resultType="com.example.myruoyi.domain.SysUser">
        SELECT user_id, user_name, password, status, del_flag, create_time
        FROM sys_user
        WHERE user_id = #{userId}
          AND del_flag = '0'
    </select>

    <!--    新增用户-->
    <insert id="insertUser" parameterType="com.example.myruoyi.domain.SysUser">
        insert into sys_user (user_name, password)
        values (#{userName}, #{password})
    </insert>

    <!--    更改用户-->
    <update id="updateUser" parameterType="com.example.myruoyi.domain.SysUser">
        update sys_user
        <set>
            <if test="userName != null">user_name = #{userName},</if>
        </set>
        where user_id = #{userId}
    </update>

    <!--    删除用户-->
    <update id="deleteUser" parameterType="com.example.myruoyi.domain.SysUser">
        update sys_user
        set del_flag = '2'
        where user_id = #{userId}
    </update>

</mapper>